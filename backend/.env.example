# Copy to .env and fill in — never commit .env.
# Backend (Spring Boot) env vars used by application.yml:

# Google AI Studio free-tier key (no credit card). Generate at https://aistudio.google.com
GEMINI_API_KEY=

# Model for interview turns / feedback (free tier default).
GEMINI_MODEL=gemini-2.5-flash

# Server port (Render injects this).
PORT=8080

# Allowed CORS origin(s), comma-separated.
FRONTEND_URL=http://localhost:5173,http://localhost:5174
